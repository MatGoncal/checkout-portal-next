# Enable /simulator route, its nav link and POST /api/simulator/fire (demo only)
ENABLE_SIMULATOR=true

# Server-side only — the browser talks to the BFF at /api/v1 with no credential.
# Never re-introduce NEXT_PUBLIC_ twins of these two.
API_KEY=demo-partner-key
WEBHOOK_SECRET=dev-webhook-secret
WEBHOOK_TOLERANCE_SECONDS=300

# Real API behind the BFF. Empty (default) answers from the in-app mock store.
# UPSTREAM_API_URL=http://localhost:3001/v1

# Optional: auto-PAID after 8s (disabled by default — use /simulator instead)
# ACMEPAY_MOCK_AUTO_PAID=true

# Optional: absolute origin for Server Component fetches (defaults to request host)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
