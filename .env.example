# Public API base (mock routes under app/api/v1 or external Nest/Laravel)
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Partner API key sent as Bearer token
NEXT_PUBLIC_API_KEY=demo-partner-key

# Webhook HMAC secret (server verifies; public twin only for portfolio simulator UI)
WEBHOOK_SECRET=dev-webhook-secret
NEXT_PUBLIC_WEBHOOK_SECRET=dev-webhook-secret

# Optional: auto-PAID after 8s (disabled by default — use /simulator instead)
# ACMEPAY_MOCK_AUTO_PAID=true

# Optional: absolute origin for Server Component fetches (defaults to request host)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
